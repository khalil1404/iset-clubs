{% extends 'base.html.twig' %}
{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">

        {# PROFILE CARD #}
        <div class="card border-0 shadow-sm overflow-hidden" style="border-radius:20px;">

            {# COVER #}
            <div style="height:120px; background:linear-gradient(135deg, #1a1a2e 0%, #4e54c8 100%);"></div>

            <div class="card-body text-center px-4 pb-4">

                {# AVATAR #}
                <div class="mt-n5 mb-3">
                    {% if user.profilePicture %}
                        <img src="/uploads/profiles/{{ user.profilePicture }}"
                             class="rounded-circle border border-4 border-white shadow"
                             width="110" height="110" style="object-fit:cover; margin-top:-55px;">
                    {% else %}
                        <div class="rounded-circle border border-4 border-white shadow d-inline-flex
                                    align-items-center justify-content-center"
                             style="width:110px;height:110px;margin-top:-55px;
                                    background:linear-gradient(135deg,#4e54c8,#8f94fb)">
                            <i class="bi bi-person-fill text-white" style="font-size:3rem"></i>
                        </div>
                    {% endif %}
                </div>

                {# INFO #}
                <h3 class="fw-bold mb-1">{{ user.fullName }}</h3>
                <p class="text-muted mb-3">
                    <i class="bi bi-envelope"></i> {{ user.email }}
                </p>

                {# ROLE BADGE #}
                {% set roleColor = user.dtype == 'admin' ? '#dc3545' : (user.dtype == 'president' ? '#6f42c1' : '#4e54c8') %}
                {% set roleIcon = user.dtype == 'admin' ? 'shield-lock' : (user.dtype == 'president' ? 'star' : 'mortarboard') %}
                <span class="badge px-4 py-2 rounded-pill mb-4 fs-6"
                      style="background:{{ roleColor }}">
                    <i class="bi bi-{{ roleIcon }}"></i> {{ user.dtype|capitalize }}
                </span>

                <hr class="my-3">

                {# STATS ROW #}
                <div class="row g-3 mb-4 text-center">
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <i class="bi bi-people-fill d-block mb-1" style="color:#4e54c8"></i>
                            <small class="text-muted">Clubs</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <i class="bi bi-calendar-event-fill d-block mb-1" style="color:#28a745"></i>
                            <small class="text-muted">Événements</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <i class="bi bi-briefcase-fill d-block mb-1" style="color:#fd7e14"></i>
                            <small class="text-muted">Candidatures</small>
                        </div>
                    </div>
                </div>

                {# ACTIONS #}
                <div class="d-flex gap-2 justify-content-center">
                    <a href="{{ path('app_profile_edit') }}"
                       class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-pencil"></i> Modifier le profil
                    </a>
                    <a href="{{ path('app_my_clubs') }}"
                       class="btn btn-outline-secondary px-4 rounded-pill">
                        <i class="bi bi-people"></i> Mes clubs
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
{% endblock %}