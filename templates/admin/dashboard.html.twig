{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="row g-4">

    {# SIDEBAR #}
    <div class="col-md-2">
        {% include 'admin/_sidebar.html.twig' %}
    </div>

    {# MAIN CONTENT #}
    <div class="col-md-10">

        {# HEADER #}
        <div class="rounded-4 text-white mb-4 p-4"
             style="background: linear-gradient(135deg, #1a1a2e 0%, #e63946 100%);">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-shield-lock-fill fs-2"></i>
                <div>
                    <h2 class="fw-bold mb-0">Dashboard Administrateur</h2>
                    <p class="mb-0 opacity-75 small">Vue d'ensemble de la plateforme ISET Clubs</p>
                </div>
            </div>
        </div>

        {# STATS CARDS #}
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px; border-left: 5px solid #4e54c8 !important;">
                    <div class="card-body d-flex align-items-center gap-3 p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width:55px;height:55px;background:linear-gradient(135deg,#4e54c8,#8f94fb)">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">{{ totalUsers }}</h3>
                            <small class="text-muted">Utilisateurs</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px; border-left: 5px solid #28a745 !important;">
                    <div class="card-body d-flex align-items-center gap-3 p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width:55px;height:55px;background:linear-gradient(135deg,#28a745,#20c997)">
                            <i class="bi bi-award-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">{{ totalClubs }}</h3>
                            <small class="text-muted">Clubs</small>
                            {% if pendingClubs > 0 %}
                                <span class="badge bg-warning text-dark d-block mt-1">{{ pendingClubs }} en attente</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px; border-left: 5px solid #17a2b8 !important;">
                    <div class="card-body d-flex align-items-center gap-3 p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width:55px;height:55px;background:linear-gradient(135deg,#17a2b8,#20c997)">
                            <i class="bi bi-calendar-event-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">{{ totalEvents }}</h3>
                            <small class="text-muted">Événements</small>
                            {% if pendingEvents > 0 %}
                                <span class="badge bg-warning text-dark d-block mt-1">{{ pendingEvents }} en attente</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px; border-left: 5px solid #fd7e14 !important;">
                    <div class="card-body d-flex align-items-center gap-3 p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width:55px;height:55px;background:linear-gradient(135deg,#fd7e14,#ffc107)">
                            <i class="bi bi-briefcase-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">{{ totalCandidatures }}</h3>
                            <small class="text-muted">Candidatures</small>
                            {% if pendingCandidatures > 0 %}
                                <span class="badge bg-danger d-block mt-1">{{ pendingCandidatures }} en attente</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 col-6">
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px; border-left: 5px solid #dc3545 !important;">
                    <div class="card-body d-flex align-items-center gap-3 p-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width:55px;height:55px;background:linear-gradient(135deg,#dc3545,#e83e8c)">
                            <i class="bi bi-chat-dots-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0">{{ totalReclamations }}</h3>
                            <small class="text-muted">Réclamations</small>
                            {% if pendingReclamations > 0 %}
                                <span class="badge bg-danger d-block mt-1">{{ pendingReclamations }} en attente</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# RECENT CLUBS TABLE #}
        <div class="card border-0 shadow-sm" style="border-radius:16px; overflow:hidden;">
            <div class="card-header d-flex justify-content-between align-items-center py-3"
                 style="background:#f8f9fa; border-bottom: 2px solid #e9ecef;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <strong>Derniers clubs soumis</strong>
                </div>
                <a href="{{ path('app_admin_clubs') }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                    Voir tout <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead style="background:#f8f9fa;">
                        <tr>
                            <th class="px-4 py-3">Nom</th>
                            <th>Domaine</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for club in recentClubs %}
                            <tr>
                                <td class="px-4 py-3 fw-bold">{{ club.name }}</td>
                                <td>
                                    <span class="badge rounded-pill bg-secondary px-3">{{ club.domain }}</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill px-3 {{
                                        club.status == 'approved' ? 'bg-success' :
                                        (club.status == 'pending' ? 'bg-warning text-dark' : 'bg-danger')
                                    }}">{{ club.status }}</span>
                                </td>
                                <td>
                                    {% if club.status == 'pending' %}
                                        <a href="{{ path('app_admin_club_approve', {id: club.id}) }}"
                                           class="btn btn-success btn-sm rounded-pill px-3">
                                            <i class="bi bi-check-lg"></i> Approuver
                                        </a>
                                        <a href="{{ path('app_admin_club_reject', {id: club.id}) }}"
                                           class="btn btn-danger btn-sm rounded-pill px-3">
                                            <i class="bi bi-x-lg"></i> Refuser
                                        </a>
                                    {% else %}
                                        <span class="text-muted small">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Aucun club récent.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
{% endblock %}