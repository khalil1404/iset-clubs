{% extends 'base.html.twig' %}
{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">

        {# HEADER #}
        <div class="rounded-4 text-white mb-4 p-4"
             style="background: linear-gradient(135deg, #1a1a2e 0%, #4e54c8 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                     style="width:50px;height:50px;background:rgba(255,255,255,0.2)">
                    <i class="bi bi-pencil-fill fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Modifier mon profil</h4>
                    <p class="mb-0 opacity-75 small">Mettez à jour vos informations personnelles</p>
                </div>
            </div>
        </div>

        {# FORM CARD #}
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">

                {# CURRENT AVATAR #}
                <div class="text-center mb-4">
                    {% if user.profilePicture %}
                        <img src="/uploads/profiles/{{ user.profilePicture }}"
                             class="rounded-circle border border-3 border-primary shadow-sm"
                             width="90" height="90" style="object-fit:cover">
                    {% else %}
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm"
                             style="width:90px;height:90px;background:linear-gradient(135deg,#4e54c8,#8f94fb)">
                            <i class="bi bi-person-fill text-white" style="font-size:2.5rem"></i>
                        </div>
                    {% endif %}
                    <p class="text-muted small mt-2 mb-0">Photo actuelle</p>
                </div>

                <form method="post" enctype="multipart/form-data">

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Prénom</label>
                            <input type="text" name="firstname" class="form-control form-control-lg"
                                   style="border-radius:10px;"
                                   value="{{ user.firstname }}" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Nom</label>
                            <input type="text" name="lastname" class="form-control form-control-lg"
                                   style="border-radius:10px;"
                                   value="{{ user.lastname }}" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-muted text-uppercase">Photo de profil</label>
                        <div class="border border-2 border-dashed rounded-3 p-3 text-center"
                             style="border-color:#dee2e6 !important; cursor:pointer;"
                             onclick="document.getElementById('photoInput').click()">
                            <i class="bi bi-cloud-upload fs-3 text-muted d-block mb-1"></i>
                            <small class="text-muted">Cliquez pour choisir une image</small>
                            <input type="file" id="photoInput" name="photo"
                                   class="d-none" accept="image/*">
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2 rounded-pill fw-bold">
                            <i class="bi bi-check-lg"></i> Sauvegarder
                        </button>
                        <a href="{{ path('app_profile') }}"
                           class="btn btn-outline-secondary px-4 rounded-pill">
                            Annuler
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
{% endblock %}