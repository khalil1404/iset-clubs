{% extends 'base.html.twig' %}
{% block title %}{{ club.name }}{% endblock %}

{% block body %}

{# HEADER BANNER #}
<div class="rounded-4 text-white mb-5 p-4"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #4e54c8 100%);">
    <div class="d-flex align-items-center gap-4">
        {% if club.logo %}
            <img src="/uploads/logos/{{ club.logo }}"
                 class="rounded-circle border border-3 border-white shadow"
                 width="90" height="90" style="object-fit:cover; flex-shrink:0;">
        {% else %}
            <div class="rounded-circle border border-3 border-white shadow d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:90px;height:90px;background:rgba(255,255,255,0.2)">
                <i class="bi bi-people-fill" style="font-size:2.5rem"></i>
            </div>
        {% endif %}
        <div>
            <h2 class="fw-bold mb-1">{{ club.name }}</h2>
            <span class="badge rounded-pill px-3 py-2 me-2" style="background:rgba(255,255,255,0.2)">
                <i class="bi bi-tag"></i> {{ club.domain }}
            </span>
            <span class="badge rounded-pill px-3 py-2 {{ club.status == 'approved' ? 'bg-success' : 'bg-warning text-dark' }}">
                {{ club.status == 'approved' ? '✓ Approuvé' : '⏳ En attente' }}
            </span>
        </div>
    </div>
</div>

<div class="row g-4">

    {# LEFT CONTENT #}
    <div class="col-md-8">

        {# DESCRIPTION #}
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-info-circle text-primary"></i> À propos
                </h5>
                <p class="text-muted mb-0">{{ club.description }}</p>
            </div>
        </div>

        {# JOIN / LEAVE BUTTONS #}
        {% if is_granted('ROLE_USER') and app.user %}
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-person-check text-success"></i> Adhésion
                    </h5>
                    <div class="d-flex gap-3">
                        <form method="post"
                              action="{{ path('app_club_join', {id: club.id}) }}">
                            <button type="submit" class="btn btn-success px-4 rounded-pill">
                                <i class="bi bi-person-plus"></i> Rejoindre le club
                            </button>
                        </form>
                        <form method="post"
                              action="{{ path('app_club_leave', {id: club.id}) }}">
                            <button type="submit" class="btn btn-outline-danger px-4 rounded-pill">
                                <i class="bi bi-person-dash"></i> Quitter le club
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {# RIGHT SIDEBAR #}
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-card-list text-primary"></i> Informations
                </h5>

                <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3" style="background:#f8f9fa;">
                    <i class="bi bi-tag-fill text-primary fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Domaine</small>
                        <strong>{{ club.domain }}</strong>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background:#f8f9fa;">
                    <i class="bi bi-check-circle-fill fs-5 {{ club.status == 'approved' ? 'text-success' : 'text-warning' }}"></i>
                    <div>
                        <small class="text-muted d-block">Statut</small>
                        <span class="badge rounded-pill {{ club.status == 'approved' ? 'bg-success' : 'bg-warning text-dark' }}">
                            {{ club.status == 'approved' ? 'Approuvé' : 'En attente' }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

{% endblock %}