{% extends 'base.html.twig' %}
{% block title %}Événements — ISET Clubs{% endblock %}

{% block body %}

{# HEADER #}
<div class="rounded-4 text-white mb-5 p-4"
     style="background: linear-gradient(135deg, #1a4731 0%, #28a745 100%);">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1">📅 Événements</h1>
            <p class="mb-0 opacity-75">Participez aux événements organisés par les clubs</p>
        </div>
        {% if is_granted('ROLE_PRESIDENT') %}
            <a href="{{ path('app_event_new') }}" class="btn btn-warning fw-bold px-4">
                <i class="bi bi-plus-circle"></i> Créer un événement
            </a>
        {% endif %}
    </div>
</div>

{# EVENTS GRID #}
<div class="row g-4">
    {% for event in events %}
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius:16px; overflow:hidden; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.15)'"
                 onmouseout="this.style.transform='translateY(0)';this.style.boxShadow=''">

                {% if event.image %}
                    <img src="/uploads/events/{{ event.image }}"
                         class="card-img-top" style="height:180px; object-fit:cover">
                {% else %}
                    <div class="d-flex align-items-center justify-content-center"
                         style="height:180px; background:linear-gradient(135deg,#28a745,#20c997)">
                        <i class="bi bi-calendar-event text-white" style="font-size:4rem; opacity:0.7"></i>
                    </div>
                {% endif %}

                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge rounded-pill bg-success px-3">
                            <i class="bi bi-calendar3"></i> {{ event.dateDebut|date('d/m/Y') }}
                        </span>
                        <span class="badge rounded-pill bg-secondary px-3">
                            <i class="bi bi-geo-alt"></i> {{ event.lieu|slice(0,15) }}
                        </span>
                    </div>
                    <h5 class="fw-bold mb-2">{{ event.nomEvenement }}</h5>
                    <p class="text-muted small mb-0">{{ event.description|slice(0,90) }}...</p>
                </div>

                <div class="card-footer bg-transparent border-0 pb-4 px-4">
                    <a href="{{ path('app_event_show', {id: event.id}) }}"
                       class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-arrow-right-circle"></i> Voir l'événement
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info rounded-4 text-center p-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-3 text-muted"></i>
                <h5>Aucun événement disponible pour le moment.</h5>
                {% if is_granted('ROLE_PRESIDENT') %}
                    <a href="{{ path('app_event_new') }}" class="btn btn-success mt-2">
                        Créer le premier événement
                    </a>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

{% endblock %}