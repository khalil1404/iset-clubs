{% extends 'base.html.twig' %}
{% block title %}Mes candidatures{% endblock %}
{% block body %}
<h2 class="mb-4">📋 Mes candidatures</h2>
{% if applications %}
    <table class="table table-hover">
        <thead class="table-dark">
            <tr><th>Poste</th><th>Club</th><th>Date</th><th>Statut</th></tr>
        </thead>
        <tbody>
            {% for a in applications %}
                <tr>
                    <td>{{ a.recrutement.title }}</td>
                    <td>{{ a.recrutement.club.name }}</td>
                    <td>{{ a.submittedAt|date('d/m/Y') }}</td>
                    <td>
                        <span class="badge {{
                            a.status == 'accepted' ? 'bg-success' :
                            (a.status == 'rejected' ? 'bg-danger' : 'bg-warning text-dark')
                        }}">{{ a.status }}</span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <div class="alert alert-info">Aucune candidature.</div>
{% endif %}
{% endblock %}