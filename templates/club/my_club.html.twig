{% extends 'base.html.twig' %}
{% block title %}Mon Club{% endblock %}

{% block body %}
{% if club %}

    {# HEADER #}
    <div class="rounded-4 text-white mb-5 p-4"
         style="background: linear-gradient(135deg, #1a1a2e 0%, #6f42c1 100%);">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
                     style="width:60px;height:60px;background:rgba(255,255,255,0.2)">
                    <i class="bi bi-star-fill fs-3"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0">{{ club.name }}</h2>
                    <p class="mb-0 opacity-75 small">
                        <i class="bi bi-tag"></i> {{ club.domain }}
                    </p>
                </div>
            </div>
            <span class="badge fs-6 px-4 py-2 rounded-pill
                {{ club.status == 'approved' ? 'bg-success' : 'bg-warning text-dark' }}">
                {{ club.status == 'approved' ? '✓ Approuvé' : '⏳ En attente' }}
            </span>
        </div>
    </div>

    {# DESCRIPTION #}
    <div class="card border-0 shadow-sm mb-5" style="border-radius:16px; border-left: 5px solid #6f42c1 !important;">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-purple"></i> À propos du club</h5>
            <p class="text-muted mb-0">{{ club.description }}</p>
        </div>
    </div>

    {# ACTION CARDS #}
    <h5 class="fw-bold mb-4">⚡ Actions rapides</h5>
    <div class="row g-4">
        <div class="col-md-3">
            <a href="{{ path('app_event_new') }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100"
                     style="border-radius:16px; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center text-white"
                         style="width:70px;height:70px;background:linear-gradient(135deg,#4e54c8,#8f94fb)">
                        <i class="bi bi-calendar-plus fs-3"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Créer un événement</h6>
                    <small class="text-muted">Organiser un nouvel événement</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a href="{{ path('app_recruitment_new') }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100"
                     style="border-radius:16px; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center text-white"
                         style="width:70px;height:70px;background:linear-gradient(135deg,#28a745,#20c997)">
                        <i class="bi bi-briefcase-fill fs-3"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Publier un recrutement</h6>
                    <small class="text-muted">Chercher de nouveaux membres</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a href="{{ path('app_president_candidatures') }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100"
                     style="border-radius:16px; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center text-white"
                         style="width:70px;height:70px;background:linear-gradient(135deg,#fd7e14,#ffc107)">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Candidatures reçues</h6>
                    <small class="text-muted">Gérer les candidatures</small>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a href="{{ path('app_club_show', {id: club.id}) }}" class="text-decoration-none">
                <div class="card border-0 shadow-sm text-center p-4 h-100"
                     style="border-radius:16px; transition: transform 0.2s;"
                     onmouseover="this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.transform='translateY(0)'">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center text-white"
                         style="width:70px;height:70px;background:linear-gradient(135deg,#17a2b8,#20c997)">
                        <i class="bi bi-eye-fill fs-3"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Voir mon club</h6>
                    <small class="text-muted">Page publique du club</small>
                </div>
            </a>
        </div>
    </div>

{% else %}
    <div class="text-center py-5">
        <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
        <h4 class="text-muted mb-3">Vous n'avez pas encore de club</h4>
        <a href="{{ path('app_club_new') }}" class="btn btn-primary px-5 rounded-pill">
            <i class="bi bi-plus-circle"></i> Créer mon club
        </a>
    </div>
{% endif %}

{% endblock %}