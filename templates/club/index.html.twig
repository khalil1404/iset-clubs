{% extends 'base.html.twig' %}
{% block title %}Clubs — ISET Clubs{% endblock %}

{% block body %}

{# HEADER #}
<div class="rounded-4 text-white mb-5 p-4"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%);">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1">🏆 Tous les clubs</h1>
            <p class="mb-0 opacity-75">Rejoignez un club et développez vos compétences</p>
        </div>
        {% if is_granted('ROLE_PRESIDENT') %}
            <a href="{{ path('app_club_new') }}" class="btn btn-warning fw-bold px-4">
                <i class="bi bi-plus-circle"></i> Créer un club
            </a>
        {% endif %}
    </div>
</div>

{# CLUBS GRID #}
<div class="row g-4">
    {% for club in clubs %}
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center" style="border-radius:16px; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.15)'"
                 onmouseout="this.style.transform='translateY(0)';this.style.boxShadow=''">
                <div class="card-body p-4">
                    {% if club.logo %}
                        <img src="/uploads/logos/{{ club.logo }}"
                             class="rounded-circle mb-3 border border-3 border-primary"
                             width="90" height="90" style="object-fit:cover">
                    {% else %}
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:90px;height:90px;background:linear-gradient(135deg,#4e54c8,#8f94fb)">
                            <i class="bi bi-people-fill text-white" style="font-size:2rem"></i>
                        </div>
                    {% endif %}
                    <h5 class="fw-bold mb-2">{{ club.name }}</h5>
                    <span class="badge rounded-pill mb-3 px-3 py-2" style="background:#4e54c8">
                        {{ club.domain }}
                    </span>
                    <p class="text-muted small mb-0">{{ club.description|slice(0,100) }}...</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4">
                    <a href="{{ path('app_club_show', {id: club.id}) }}"
                       class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-eye"></i> Voir le club
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info rounded-4 text-center p-5">
                <i class="bi bi-people fs-1 d-block mb-3 text-muted"></i>
                <h5>Aucun club disponible pour le moment.</h5>
                {% if is_granted('ROLE_PRESIDENT') %}
                    <a href="{{ path('app_club_new') }}" class="btn btn-primary mt-2">
                        Créer le premier club
                    </a>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

{% endblock %}