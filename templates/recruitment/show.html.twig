{% extends 'base.html.twig' %}
{% block title %}{{ offer.title }}{% endblock %}

{% block body %}

{# HEADER BANNER #}
<div class="rounded-4 text-white mb-5 p-4"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #6f42c1 100%);">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center text-white flex-shrink-0"
             style="width:60px;height:60px;background:rgba(255,255,255,0.2)">
            <i class="bi bi-briefcase-fill fs-3"></i>
        </div>
        <div>
            <h2 class="fw-bold mb-1">{{ offer.title }}</h2>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge rounded-pill px-3 py-2" style="background:rgba(255,255,255,0.2)">
                    <i class="bi bi-people"></i> {{ offer.club.name }}
                </span>
                <span class="badge rounded-pill px-3 py-2 bg-danger">
                    <i class="bi bi-clock"></i> Deadline : {{ offer.deadline|date('d/m/Y') }}
                </span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    {# LEFT CONTENT #}
    <div class="col-md-8">

        {# DESCRIPTION #}
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-file-text text-primary"></i> Description
                </h5>
                <p class="text-muted mb-0">{{ offer.description }}</p>
            </div>
        </div>

        {# REQUIREMENTS #}
        {% if offer.requirements %}
            <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-check2-square text-success"></i> Prérequis
                    </h5>
                    <p class="text-muted mb-0">{{ offer.requirements }}</p>
                </div>
            </div>
        {% endif %}

        {# APPLY FORM #}
        {% if is_granted('ROLE_USER') and app.user %}
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-send text-purple"></i> Postuler à cette offre
                    </h5>
                    <form method="post" enctype="multipart/form-data"
                          action="{{ path('app_recruitment_apply', {id: offer.id}) }}">

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted text-uppercase">
                                Message de motivation
                            </label>
                            <textarea name="message" class="form-control" rows="5"
                                      style="border-radius:10px;"
                                      placeholder="Expliquez pourquoi vous souhaitez rejoindre ce club..."
                                      required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase">
                                CV (PDF uniquement)
                            </label>
                            <div class="border border-2 rounded-3 p-3 text-center"
                                 style="border-style:dashed !important; cursor:pointer;"
                                 onclick="document.getElementById('cvInput').click()">
                                <i class="bi bi-file-earmark-pdf text-danger fs-3 d-block mb-1"></i>
                                <small class="text-muted">Cliquez pour choisir votre CV en PDF</small>
                                <input type="file" id="cvInput" name="cv"
                                       class="d-none" accept=".pdf" required>
                            </div>
                        </div>

                        <button type="submit"
                                class="btn fw-bold px-5 rounded-pill text-white"
                                style="background:linear-gradient(135deg,#6f42c1,#8f94fb)">
                            <i class="bi bi-send"></i> Envoyer ma candidature
                        </button>
                    </form>
                </div>
            </div>
        {% endif %}

    </div>

    {# RIGHT SIDEBAR #}
    <div class="col-md-4">

        {# CLUB CARD #}
        <div class="card border-0 shadow-sm mb-4 text-center" style="border-radius:16px;">
            <div class="card-body p-4">
                <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:70px;height:70px;background:linear-gradient(135deg,#28a745,#20c997)">
                    <i class="bi bi-people-fill text-white fs-3"></i>
                </div>
                <h5 class="fw-bold">{{ offer.club.name }}</h5>
                <p class="text-muted small mb-0">Club recruteur</p>
            </div>
        </div>

        {# OFFER INFO #}
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">📋 Informations</h6>

                <div class="d-flex gap-2 mb-3 p-3 rounded-3" style="background:#f8f9fa;">
                    <i class="bi bi-clock-fill text-danger fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Date limite</small>
                        <strong class="small">{{ offer.deadline|date('d/m/Y') }}</strong>
                    </div>
                </div>

                <div class="d-flex gap-2 p-3 rounded-3" style="background:#f8f9fa;">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Statut</small>
                        <span class="badge bg-success rounded-pill">Ouverte</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

{% endblock %}